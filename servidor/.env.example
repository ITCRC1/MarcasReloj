DJANGO_SECRET_KEY=
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# false en la red local (el servidor habla HTTP plano).
# true en Railway o detras de un proxy con TLS: activa cookies seguras y HSTS.
DJANGO_HTTPS=false

# Vacio o ausente = SQLite en servidor/asistencia.sqlite3 (desarrollo).
# Produccion local:  mysql://asistencia:clave@127.0.0.1:3306/asistencia
# Railway:           lo inyecta la plataforma como postgres://...
DATABASE_URL=

ALERTA_AGENTE_MINUTOS=15

# --- Lectura directa de SmartPSS ---
# Cuando SmartPSS escribe en esta misma base, no hace falta el agente.
# El nombre de la tabla lo pone SmartPSS; averiguelo con:
#   manage.py leer_smartpss --explorar
SMARTPSS_TABLA=

# Cuanto se relee hacia atras en cada pasada, por si SmartPSS escribio marcas
# con horas pasadas al volver de estar cerrado. Los duplicados se descartan.
SMARTPSS_VENTANA_HORAS=48

# Desde cuando traer marcas la primera vez. Vacio = todo lo que haya en la tabla.
SMARTPSS_FECHA_INICIO=
